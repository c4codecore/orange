{
  "expo": {
    "name": "Orange",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/orangeLogo.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nrjsrm.orange",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "permissions": [],
      "blockedPermissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/orangeLogo.png",
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.nrjsrm.frontend"
    },
    "web": {
      "favicon": "./assets/orangeLogo.png"
    },
    "extra": {
      "eas": {
        "projectId": "47bc7765-7c90-4b6f-a65a-31b71c8707b6"
      }
    }
  }
}